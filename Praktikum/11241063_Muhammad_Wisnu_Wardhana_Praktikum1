        "# TODO 1.1 — LUT negatif, logaritmik, gamma\n",
        "r = np.arange(256, dtype=np.float64)\n",
        "\n",
        "def bulat(x):\n",
        "    return np.floor(x + 0.5)\n",
        "\n",
        "def lut_negatif():\n",
        "    return bulat(255 - r).astype(np.uint8)\n",
        "\n",
        "def lut_log():\n",
        "    c = 255 / np.log(256)          # agar r = 255 dipetakan ke 255\n",
        "    return bulat(c * np.log1p(r)).astype(np.uint8)\n",
        "\n",
        "def lut_gamma(g):\n",
        "    return bulat(255 * (r / 255) ** g).astype(np.uint8)\n",
