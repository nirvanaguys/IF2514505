        "# Sel persiapan — jalankan tanpa diubah\n",
        "import numpy as np\n",
        "import cv2\n",
        "import matplotlib.pyplot as plt\n",
        "import time\n",
        "\n",
        "plt.rcParams['figure.dpi'] = 110\n",
        "print('NumPy', np.__version__, '| OpenCV', cv2.__version__)\n",
        "\n",
        "\"\"\"Pembangkit citra uji sintetis (benih acak tetap, hanya NumPy).\n",
        "\n",
        "Hanya memakai NumPy (tanpa fungsi gambar OpenCV) agar citra identik di versi\n",
        "OpenCV mana pun. Seluruh citra bebas persoalan lisensi dan reprodusibel.\n",
        "\"\"\"\n",
        "import numpy as np\n",
        "\n",
        "BENIH = 2026\n",
        "\n",
        "\n",
        "def _grid(h, w):\n",
        "    return np.mgrid[0:h, 0:w].astype(np.float64)\n",
        "\n",
        "\n",
        "def _adegan(rng, h=256, w=256):\n",
        "    \"\"\"Adegan dasar: gradasi, lingkaran, persegi, elips, segitiga, garis halus (float 0..1).\"\"\"\n",
        "    yy, xx = _grid(h, w)\n",
        "    img = 0.35 + 0.25 * (xx / w) + 0.10 * np.sin(yy / 23.0)\n",
        "    img[(xx - 70) ** 2 + (yy - 80) ** 2 <= 38 ** 2] = 0.85                    # lingkaran terang\n",
        "    img[(yy >= 40) & (yy <= 110) & (xx >= 140) & (xx <= 225)] = 0.15          # persegi gelap\n",
        "    u, v = xx - 175, yy - 185\n",
        "    t = np.deg2rad(20)\n",
        "    ue, ve = u * np.cos(t) + v * np.sin(t), -u * np.sin(t) + v * np.cos(t)\n",
        "    img[(ue / 55) ** 2 + (ve / 30) ** 2 <= 1] = 0.65                          # elips\n",
        "    img[(yy >= 150) & (yy <= 235) & (xx >= 30) & (xx <= 30 + (yy - 150) * 1.05)] = 0.95  # segitiga\n",
        "    for i in range(6):                                                          # rincian halus\n",
        "        img[128:141, 20 + 36 * i] = 0.05\n",
        "    img += rng.normal(0, 0.01, img.shape)\n",
        "    return np.clip(img, 0, 1)\n",
        "\n",
        "\n",
        "def citra_redup(rng):\n",
        "    \"\"\"Kontras rendah: intensitas termampatkan ke rentang sempit (kira-kira 40..115).\"\"\"\n",
        "    return np.clip(40 + 75 * _adegan(rng), 0, 255).round().astype(np.uint8)\n",
        "\n",
        "\n",
        "def dokumen_tak_merata(rng, h=240, w=320):\n",
        "    \"\"\"'Baris teks' gelap di atas kertas terang, pencahayaan dari kiri atas.\"\"\"\n",
        "    img = np.full((h, w), 0.92)\n",
        "    for b in range(9):                                    # 9 baris teks\n",
        "        y0 = 18 + 24 * b\n",
        "        x = 14\n",
        "        while x < w - 20:\n",
        "            pj = int(rng.integers(10, 38))                # panjang 'kata'\n",
        "            if x + pj > w - 14:\n",
        "                break\n",
        "            img[y0:y0 + 9, x:x + pj] = 0.14\n",
        "            img[y0 + 2:y0 + 7, x + 2:x + pj - 2:4] = 0.55  # celah antarhuruf\n",
        "            x += pj + int(rng.integers(6, 12))\n",
        "    yy, xx = _grid(h, w)\n",
        "    cahaya = 1.05 - 0.80 * ((xx / w) * 0.6 + (yy / h) * 0.4)\n",
        "    img = img * cahaya + rng.normal(0, 0.012, (h, w))\n",
        "    return np.clip(255 * img, 0, 255).round().astype(np.uint8)\n",
        "\n",
        "\n",
        "def citra_bersih(rng):\n",
        "    \"\"\"Kebenaran dasar untuk uji penapis (rentang penuh).\"\"\"\n",
        "    return np.clip(255 * _adegan(rng), 0, 255).round().astype(np.uint8)\n",
        "\n",
        "\n",
        "def beri_derau(img, rng, sigma=12.0, p_sp=0.04):\n",
        "    \"\"\"Derau Gaussian (sigma) ditambah derau garam-merica (proporsi p_sp).\"\"\"\n",
        "    g = img.astype(np.float64) + rng.normal(0, sigma, img.shape)\n",
        "    u = rng.random(img.shape)\n",
        "    g[u < p_sp / 2] = 0\n",
        "    g[(u >= p_sp / 2) & (u < p_sp)] = 255\n",
        "    return np.clip(g, 0, 255).round().astype(np.uint8)\n",
        "\n",
        "\n",
        "def perairan_berkabut(rng, h=240, w=360):\n",
        "    \"\"\"Langit, laut bergelombang, dua kapal, kabut (kontras rendah), derau sensor.\"\"\"\n",
        "    yy, xx = _grid(h, w)\n",
        "    cak = 95\n",
        "    langit = 0.78 - 0.15 * (yy / cak)\n",
        "    laut = 0.42 + 0.06 * np.sin(xx / 9.0 + yy / 4.0) - 0.10 * ((yy - cak) / (h - cak))\n",
        "    img = np.where(yy < cak, langit, laut)\n",
        "    # kapal besar: lambung trapesium + bangunan + cerobong\n",
        "    lambung = (yy >= 150) & (yy <= 172) & (xx >= 60 + (yy - 150) * 0.7) & (xx <= 190 - (yy - 150) * 0.7)\n",
        "    img[lambung] = 0.12\n",
        "    img[(yy >= 122) & (yy < 150) & (xx >= 95) & (xx <= 150)] = 0.18\n",
        "    img[(yy >= 105) & (yy < 122) & (xx >= 118) & (xx <= 128)] = 0.10\n",
        "    # kapal kecil di kejauhan\n",
        "    img[(yy >= 108) & (yy <= 116) & (xx >= 255 + (yy - 108) * 0.6) & (xx <= 305 - (yy - 108) * 0.6)] = 0.22\n",
        "    img[(yy >= 99) & (yy < 108) & (xx >= 272) & (xx <= 288)] = 0.25\n",
        "    kabut = 0.55\n",
        "    img = (1 - kabut) * img + kabut * 0.70\n",
        "    img += rng.normal(0, 0.018, img.shape)\n",
        "    return np.clip(255 * img, 0, 255).round().astype(np.uint8)\n",
        "\n",
        "\n",
        "def masker_perairan(h=240, w=360):\n",
        "    \"\"\"Masker kebenaran dasar: (kapal, laut). Laut = di bawah cakrawala, di luar kapal, dengan jarak aman.\"\"\"\n",
        "    yy, xx = _grid(h, w)\n",
        "    kapal = np.zeros((h, w), bool)\n",
        "    kapal |= (yy >= 150) & (yy <= 172) & (xx >= 60 + (yy - 150) * 0.7) & (xx <= 190 - (yy - 150) * 0.7)\n",
        "    kapal |= (yy >= 122) & (yy < 150) & (xx >= 95) & (xx <= 150)\n",
        "    kapal |= (yy >= 105) & (yy < 122) & (xx >= 118) & (xx <= 128)\n",
        "    kapal |= (yy >= 108) & (yy <= 116) & (xx >= 255 + (yy - 108) * 0.6) & (xx <= 305 - (yy - 108) * 0.6)\n",
        "    kapal |= (yy >= 99) & (yy < 108) & (xx >= 272) & (xx <= 288)\n",
        "    sekitar = np.zeros_like(kapal)\n",
        "    sekitar[95:185, 45:205] = True\n",
        "    sekitar[92:125, 245:315] = True\n",
        "    laut = (yy >= 100) & ~sekitar\n",
        "    return kapal, laut\n",
        "\n",
        "\n",
        "def bangkitkan_semua():\n",
        "    rng = np.random.default_rng(BENIH)\n",
        "    redup = citra_redup(rng)\n",
        "    dok = dokumen_tak_merata(rng)\n",
        "    bersih = citra_bersih(rng)\n",
        "    berderau = beri_derau(bersih, rng)\n",
        "    laut = perairan_berkabut(rng)\n",
        "    return {\"redup\": redup, \"dokumen\": dok, \"bersih\": bersih, \"berderau\": berderau, \"perairan\": laut}\n",
        "\n",
        "def tampil(daftar, judul=None, kolom=None, tinggi=3.0):\n",
        "    n = len(daftar); kolom = kolom or n; baris = int(np.ceil(n / kolom))\n",
        "    fig, ax = plt.subplots(baris, kolom, figsize=(3.4 * kolom, tinggi * baris))\n",
        "    ax = np.atleast_1d(ax).ravel()\n",
        "    for a in ax: a.axis('off')\n",
        "    for a, im, t in zip(ax, daftar, judul or [''] * n):\n",
        "        a.imshow(im, cmap='gray', vmin=0, vmax=255); a.set_title(t, fontsize=9)\n",
        "    plt.tight_layout(); plt.show()\n",
        "\n",
        "def gambar_hist(ax, im, judul=''):\n",
        "    h = np.bincount(im.ravel(), minlength=256)\n",
        "    ax.bar(np.arange(256), h, width=1.0, color='#16324F')\n",
        "    a2 = ax.twinx(); a2.plot(np.cumsum(h) / h.sum(), color='#C2680E', lw=1.5, ls='--'); a2.set_ylim(0, 1.05)\n",
        "    ax.set_title(judul, fontsize=9); ax.set_xlim(-2, 257)\n",
        "\n",
        "def entropi(im):\n",
        "    h = np.bincount(im.ravel(), minlength=256).astype(float); p = h[h > 0] / h.sum()\n",
        "    return float(-(p * np.log2(p)).sum())\n",
        "\n",
        "def psnr(acuan, uji):\n",
        "    mse = np.mean((acuan.astype(float) - uji.astype(float)) ** 2)\n",
        "    return float('inf') if mse == 0 else float(10 * np.log10(255 ** 2 / mse))\n",
        "\n",
        "def ringkas(nama, im):\n",
        "    print(f'{nama:24s} rerata {im.mean():7.2f}  std {im.std():6.2f}  min {im.min():3d}  maks {im.max():3d}'\n",
        "          f'  aras {len(np.unique(im)):3d}  entropi {entropi(im):.4f}')\n",
        "\n",
        "C = bangkitkan_semua()\n",
        "redup, dok, bersih, berderau, perairan = C['redup'], C['dokumen'], C['bersih'], C['berderau'], C['perairan']\n",
        "kabur = cv2.GaussianBlur(bersih, (9, 9), 1.5)   # masukan untuk Bagian 3.3\n",
        "for k, v in C.items(): print(f'{k:9s}', v.shape, v.dtype, 'min', v.min(), 'maks', v.max())\n",
        "tampil([redup, dok, bersih, berderau, perairan], list(C.keys()))"
      ]
    },
